{
  "type": "object",
  "properties": {
    "intervalMinutes": {
      "type": "number",
      "title": "醒来的间隔（分钟）",
      "description": "两次自主醒来之间的基准间隔；她可以自己用 mind_pace 临时改。",
      "default": 15,
      "minimum": 1,
      "maximum": 720
    },
    "firstDelayMinutes": {
      "type": "number",
      "title": "启用后第一次醒来（分钟）",
      "description": "插件启动后等多久才给第一次自主时间；0 表示立刻。",
      "default": 2,
      "minimum": 0,
      "maximum": 720
    },
    "jitter": {
      "type": "number",
      "title": "间隔抖动",
      "description": "0～1：每次醒来时间在基准间隔上随机前后浮动，避免像闹钟一样机械。",
      "default": 0.4,
      "minimum": 0,
      "maximum": 1
    },
    "maxWakesPerHour": {
      "type": "integer",
      "title": "每小时最多醒来几次",
      "description": "硬上限；到顶后自动往后顺延，不会因为改配置而突破。",
      "default": 6,
      "minimum": 1,
      "maximum": 60
    },
    "quietStart": {
